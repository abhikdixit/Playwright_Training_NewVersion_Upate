{
  "testCases": [
    {
      "id": "TC001",
      "description": "Valid login with correct credentials",
      "email": "testing@abc.com",
      "password": "pass1234",
      "expected": {
        "status": 200,
        "success": true,
        "message": "Login successful",
        "name": "Dixit",
        "email": "testing@abc.com"
      }
    },
    {
      "id": "TC002",
      "description": "Invalid password",
      "email": "testing@abc.com",
      "password": "wrongpass",
      "expected": {
        "status": 401,
        "success": false
      }
    },
    {
      "id": "TC003",
      "description": "Invalid email",
      "email": "wrong@abc.com",
      "password": "pass1234",
      "expected": {
        "status": 401,
        "success": false
      }
    },
    {
      "id": "TC004",
      "description": "Missing password",
      "email": "testing@abc.com",
      "password": "",
      "expected": {
        "status": 400,
        "success": false
      }
    },
    {
      "id": "TC005",
      "description": "Missing email",
      "email": "",
      "password": "pass1234",
      "expected": {
        "status": 400,
        "success": false
      }
    },
    {
      "id": "TC006",
      "description": "Empty email and password",
      "email": "",
      "password": "",
      "expected": {
        "status": 400,
        "success": false
      }
    },
    {
      "id": "TC007",
      "description": "Invalid email format",
      "email": "testingabc.com",
      "password": "pass1234",
      "expected": {
        "status": 400,
        "success": false
      }
    }
  ]
}
